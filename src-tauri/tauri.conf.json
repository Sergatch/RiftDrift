{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RiftDrift",
  "version": "0.1.0",
  "identifier": "com.riftdrift.desktop",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run desktop:web:dev",
    "beforeBuildCommand": "npm run desktop:web:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RiftDrift",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "fileAssociations": [
      {
        "ext": ["riftdrift"],
        "name": "RiftDrift Library",
        "description": "Portable RiftDrift sections and command history",
        "role": "Editor",
        "mimeType": "application/vnd.riftdrift.library+json",
        "exportedType": {
          "identifier": "com.riftdrift.library",
          "conformsTo": ["public.json", "public.data"]
        }
      }
    ],
    "shortDescription": "A terminal with your command library built in.",
    "longDescription": "RiftDrift is a native command-line workspace for macOS with tabs, detachable windows, command history, custom sections, and portable library files.",
    "copyright": "Copyright © 2026 RiftDrift",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
